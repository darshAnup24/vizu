# Gemini API key for shader generation
GOOGLE_API_KEY=your-gemini-api-key

# Local embedding and Chroma settings
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_COLLECTION=shaders_local

# MongoDB connection
MONGO_URL=mongodb://localhost:27017
SOURCE_MONGO_URL=mongodb://localhost:27017
DESTINATION_MONGO_URL=mongodb://destination_host:27017
